{
  "name": "nodewarden-ops-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only NodeWarden operations CLI",
  "license": "LGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "nwctl": "bin/nwctl.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "node --import tsx --test test/e2e/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "commander": "15.0.0",
    "@types/node": "22.19.15",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
